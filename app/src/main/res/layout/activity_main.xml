<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101018">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/barsik_blur" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/avatarRing"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_ring"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Барсик"
                    android:scaleType="centerCrop"
                    android:src="@drawable/barsik_avatar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Барсик"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="онлайн"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/keyBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_glass"
                android:gravity="center"
                android:text="🔑"
                android:textSize="18sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/msgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFlash"
                    style="@style/Chip"
                    android:text="🔦 Фонарик" />

                <TextView
                    android:id="@+id/chipAlarm"
                    style="@style/Chip"
                    android:text="⏰ Будильник" />

                <TextView
                    android:id="@+id/chipMusic"
                    style="@style/Chip"
                    android:text="🎵 Музыка" />

                <TextView
                    android:id="@+id/chipTimer"
                    style="@style/Chip"
                    android:text="⏱ Таймер" />

                <TextView
                    android:id="@+id/chipSettings"
                    style="@style/Chip"
                    android:text="⚙️ Настройки" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Скажи что-нибудь Барсику"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/micBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_glass"
                android:contentDescription="Голос"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/sendBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_send"
                android:contentDescription="Отправить"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
